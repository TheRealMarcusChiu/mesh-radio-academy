---
// Two radios with matching LoRa settings but different native mesh protocols.
const rows = [
  { label: 'App', note: 'separate apps' },
  { label: 'Phone–radio link', note: 'local only' },
  { label: 'Mesh protocol', note: 'different format', bad: true },
  { label: 'LoRa modulation', note: 'same', ok: true },
  { label: 'Radio settings', note: 'same', ok: true },
];
const y = (i: number) => 14 + i * 58;
---

<figure class="diagram not-content">
  <svg viewBox="0 0 360 310" role="img" aria-labelledby="ls-title ls-desc">
    <title id="ls-title">Two radios: same radio layers, different mesh protocols</title>
    <desc id="ls-desc">
      Left stack: a Meshtastic node. Right stack: a MeshCore node. The bottom two layers, radio settings and
      LoRa modulation, match, so each radio can pick up the other's signal. The mesh protocol layer differs,
      so neither can read the other's packets. The app and phone link layers are separate on each side.
    </desc>
    <text x="64" y="10" class="hdr" text-anchor="middle">Meshtastic node</text>
    <text x="296" y="10" class="hdr" text-anchor="middle">MeshCore node</text>
    {rows.map((r, i) => (
      <g>
        <rect x="4" y={y(i) + 4} width="120" height="44" rx="3" class:list={['box', { bad: r.bad }]} />
        <text x="64" y={y(i) + 31} text-anchor="middle">{r.label}</text>
        <rect x="236" y={y(i) + 4} width="120" height="44" rx="3" class:list={['box', { bad: r.bad }]} />
        <text x="296" y={y(i) + 31} text-anchor="middle">{r.label}</text>
        {r.ok && <line x1="126" y1={y(i) + 26} x2="234" y2={y(i) + 26} class="link-ok" />}
        {r.bad && (
          <>
            <line x1="126" y1={y(i) + 26} x2="168" y2={y(i) + 26} class="link-bad" />
            <line x1="192" y1={y(i) + 26} x2="234" y2={y(i) + 26} class="link-bad" />
            <text x="180" y={y(i) + 31} text-anchor="middle" class="mark">✕</text>
          </>
        )}
        <text x="180" y={y(i) + (r.ok || r.bad ? 16 : 31)} text-anchor="middle" class="note">{r.note}</text>
      </g>
    ))}
  </svg>
  <figcaption>
    Matching radio settings let the signal through. Different mesh protocols mean neither side can read
    the other's messages.
  </figcaption>
  <table>
    <caption>Text version of the diagram</caption>
    <thead><tr><th scope="col">Layer</th><th scope="col">Meshtastic node vs MeshCore node</th></tr></thead>
    <tbody>
      <tr><th scope="row">App</th><td>Different apps, each talking only to its own radio.</td></tr>
      <tr><th scope="row">Phone–radio link</th><td>Local Bluetooth or USB link on each side; never crosses between the two.</td></tr>
      <tr><th scope="row">Mesh protocol</th><td><strong>Different.</strong> Each uses its own packet format, so neither can read the other's packets.</td></tr>
      <tr><th scope="row">LoRa modulation</th><td>Same. Each radio can demodulate the other's signal.</td></tr>
      <tr><th scope="row">Radio settings</th><td>Same frequency, bandwidth, spreading factor and coding rate in this example.</td></tr>
    </tbody>
  </table>
</figure>

<style>
  svg {
    width: 100%;
    max-width: 30rem;
    height: auto;
    display: block;
    font-family: var(--__sl-font);
  }
  text {
    fill: var(--sl-color-gray-1);
    font-size: 13px;
  }
  .hdr {
    font-weight: 600;
    font-size: 12px;
  }
  .note {
    fill: var(--sl-color-gray-3);
    font-size: 11px;
    font-style: italic;
  }
  .mark {
    fill: var(--sl-color-gray-1);
    font-size: 16px;
  }
  .box {
    fill: var(--sl-color-gray-6);
    stroke: var(--sl-color-gray-4);
  }
  .box.bad {
    stroke: var(--sl-color-gray-1);
    stroke-dasharray: 5 3;
  }
  .link-ok {
    stroke: var(--sl-color-accent);
    stroke-width: 3;
  }
  .link-bad {
    stroke: var(--sl-color-gray-3);
    stroke-width: 2;
    stroke-dasharray: 3 4;
  }
</style>
