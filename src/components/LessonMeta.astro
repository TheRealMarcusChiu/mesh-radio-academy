---
import { getEntry } from 'astro:content';
import type { LessonMeta } from '../lib/lesson-schema.ts';

interface Props {
  lesson: LessonMeta;
}
const { lesson } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

// Prerequisites must name real pages; a typo fails the build instead of shipping a dead link.
const prereqs = await Promise.all(
  lesson.prerequisites.map(async (slug) => {
    const entry = await getEntry('docs', slug);
    if (!entry) throw new Error(`Lesson prerequisite "${slug}" is not a page`);
    return { href: `${base}${slug}/`, title: entry.data.title };
  }),
);
const reviewed = lesson.reviewed.toISOString().slice(0, 10);
---

<aside class="lesson-meta not-content" aria-label="About this lesson">
  <dl>
    <div><dt>Time</dt><dd>About {lesson.estimatedMinutes} minutes</dd></div>
    <div><dt>Level</dt><dd>{lesson.difficulty[0].toUpperCase() + lesson.difficulty.slice(1)}</dd></div>
    <div>
      <dt>Before this</dt>
      <dd>
        {prereqs.length
          ? prereqs.map((p, i) => (<>{i > 0 && ', '}<a href={p.href}>{p.title}</a></>))
          : 'Nothing. No radio needed.'}
      </dd>
    </div>
    <div><dt>Checked against</dt><dd>{lesson.baseline}, reviewed {reviewed}</dd></div>
  </dl>
  <h2 class="outcomes-title">By the end you can</h2>
  <ul>{lesson.outcomes.map((o) => <li>{o}</li>)}</ul>
</aside>

<style>
  .lesson-meta {
    margin-top: 1rem;
    padding: 1rem 1.25rem;
    border-inline-start: 3px solid var(--sl-color-accent);
    background: var(--sl-color-gray-6);
  }
  dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 0.5rem 1.5rem;
    margin: 0;
  }
  dt {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  dd {
    margin: 0;
  }
  .outcomes-title {
    font-size: var(--sl-text-lg);
    margin: 1rem 0 0.25rem;
  }
  ul {
    margin: 0;
    padding-inline-start: 1.25rem;
  }
</style>
