  }
  .fw-wide {
    margin-top: 1rem;
  }
  .fw-field label {
    font-size: var(--sl-text-sm);
  }
  .fw input[type='text'],
  .fw select,
  .fw textarea {
    min-height: 2.75rem;
    font: inherit;
