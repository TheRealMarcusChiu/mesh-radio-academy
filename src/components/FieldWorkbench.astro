    width: 100%;
    resize: vertical;
  }
  .fw [aria-invalid='true'] {
    border-color: var(--sl-color-accent);
    border-width: 2px;
  }
  .fw-check {
    flex-direction: row;
    align-items: center;
    min-height: 2.75rem;
  }
  .fw input[type='checkbox'],
  .fw input[type='radio'] {
    width: 1.25rem;
    height: 1.25rem;
    accent-color: var(--sl-color-accent);
