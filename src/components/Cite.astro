---
/** Inline evidence links: claim IDs go to the claim ledger, source IDs (…-S01) to the registry. */
interface Props {
  ids: string;
}
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const ids = Astro.props.ids.split(/\s+/).filter(Boolean);
const href = (id: string) =>
  `${base}reference/${/-S\d+$/.test(id) ? 'sources' : 'claims'}/#${id.toLowerCase()}`;
---

<span class="cite">[{ids.map((id, i) => (<>{i > 0 && ', '}<a href={href(id)}>{id}</a></>))}]</span>

<style>
  .cite {
    font-size: var(--sl-text-xs);
    white-space: nowrap;
    color: var(--sl-color-gray-3);
  }
  .cite a {
    color: inherit;
  }
</style>
