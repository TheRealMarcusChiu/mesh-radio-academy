---
/** Evidence links for lab components; every ID links to its ledger anchor, like Cite.astro. */
interface Props {
  ids: string[];
}
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const href = (id: string) => `${base}reference/${/-S\d+$/.test(id) ? 'sources' : 'claims'}/#${id.toLowerCase()}`;
---

<span class="cite">[{Astro.props.ids.map((id, i) => (
  <>{i > 0 && ', '}<a href={href(id)}>{id}</a></>
))}]</span>

<style>
  .cite {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  .cite a {
    color: inherit;
    white-space: nowrap;
  }
</style>
