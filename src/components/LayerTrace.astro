---
import { STAGES, LAYER_LABELS } from '../lib/layer-trace.ts';
---

<section class="trace" data-trace aria-labelledby="trace-title">
  <h2 id="trace-title" class="trace-title">Send a message between two radios</h2>
  <p class="trace-note">
    A teaching model of one message between two people, each with a phone and a
    radio. It shows the layers, not the exact routing rules of any one system.
  </p>

  <div class="trace-controls" role="group" aria-label="Message trace controls" hidden data-controls>
    <button type="button" class="btn btn-primary" data-send>Send message</button>
    <button type="button" class="btn" data-step>Step</button>
    <button type="button" class="btn" data-reset>Reset</button>
  </div>

  <ol class="chain" aria-label="Path of the message">
    {STAGES.map((s) => (
      <li class:list={['chain-item', s.layer === 'app' || s.layer === 'mesh' ? 'is-node' : 'is-link', `layer-${s.layer}`]} data-stage={s.id}>
        {s.layer === 'app' && (
          <svg class="glyph" viewBox="0 0 24 24" aria-hidden="true"><rect x="7" y="2.5" width="10" height="19" rx="2" /><line x1="10.5" y1="18.5" x2="13.5" y2="18.5" /></svg>
        )}
        {s.layer === 'mesh' && (
          <svg class="glyph" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="1.5" /><line x1="16" y1="10" x2="18" y2="2.5" /><circle cx="9" cy="15.5" r="1.6" /></svg>
        )}
        {(s.layer === 'link' || s.layer === 'rf') && <span class="wire" aria-hidden="true" />}
        <span class="chain-where">{s.where}</span>
        <span class="chain-layer">{s.layerLabel}</span>
      </li>
    ))}
  </ol>

  <div class="legend" aria-label="Legend">
    <span class="key key-link">Dotted line: short local link between your own devices ({LAYER_LABELS.link})</span>
    <span class="key key-rf">Wavy line: over-the-air radio signal ({LAYER_LABELS.rf})</span>
  </div>

  <p class="trace-live visually-hidden" aria-live="polite" data-live></p>

  <h3 class="log-title">What happens at each step</h3>
  <p class="log-nojs" data-nojs>All seven steps are listed below. With JavaScript on, you can reveal them one at a time.</p>
  <ol class="log" data-log>
    {STAGES.map((s) => (
      <li data-stage={s.id}>
        <strong>{s.title}</strong> <span class="log-meta">({s.where}, {s.layerLabel.toLowerCase()} layer)</span>
        <p>{s.explain}</p>
      </li>
    ))}
  </ol>
  <p class="offgrid" data-offgrid>
    None of these steps used the internet or a cellular network. If both
    radios are in range with matching settings, this path still works when
    those services are down. Range and reliability depend on the radios,
    antennas, terrain and settings; later modules show how to measure them.
  </p>
</section>

<script>
  import { STAGES, initialStep, step, run, reset } from '../lib/layer-trace.ts';

  for (const root of document.querySelectorAll<HTMLElement>('[data-trace]')) {
    const q = <T extends Element>(sel: string) => root.querySelector<T>(sel)!;
    const send = q<HTMLButtonElement>('[data-send]');
    const stepBtn = q<HTMLButtonElement>('[data-step]');
    const resetBtn = q<HTMLButtonElement>('[data-reset]');
    const live = q<HTMLElement>('[data-live]');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    let pos = initialStep;
    let timer: ReturnType<typeof setInterval> | undefined;

    const stop = () => {
      clearInterval(timer);
      timer = undefined;
      send.textContent = pos === STAGES.length ? 'Send again' : pos ? 'Continue' : 'Send message';
    };

    const render = () => {
      root.dataset.pos = String(pos);
      STAGES.forEach((s, i) => {
        for (const el of root.querySelectorAll<HTMLElement>(`[data-stage="${s.id}"]`)) {
          el.classList.toggle('is-done', i < pos - 1);
          el.classList.toggle('is-current', i === pos - 1);
          if (el.closest('[data-log]')) el.hidden = i >= pos;
        }
      });
      q<HTMLElement>('[data-offgrid]').hidden = pos < STAGES.length;
      const current = STAGES[pos - 1];
      live.textContent = current
        ? `Step ${pos} of ${STAGES.length}: ${current.title}. ${current.where}.`
        : 'Ready. Nothing sent yet.';
      stepBtn.disabled = pos === STAGES.length;
    };

    send.addEventListener('click', () => {
      if (timer) return stop();
      if (pos === STAGES.length) pos = reset();
      if (reduced.matches) {
        pos = run(pos);
        render();
        return stop();
      }
      pos = step(pos);
      render();
      send.textContent = 'Pause';
      timer = setInterval(() => {
        pos = step(pos);
        render();
        if (pos === STAGES.length) stop();
      }, 1100);
    });
    stepBtn.addEventListener('click', () => {
      stop();
      pos = step(pos);
      render();
      stop();
    });
    resetBtn.addEventListener('click', () => {
      pos = reset();
      stop();
      render();
    });

    q<HTMLElement>('[data-controls]').hidden = false;
    q<HTMLElement>('[data-nojs]').hidden = true;
    render();
  }
</script>

<style>
  .trace {
    margin-block: 1.5rem 0;
  }
  .trace-title {
    font-size: var(--sl-text-2xl);
  }
  .trace-note {
    color: var(--sl-color-gray-3);
    max-width: 62ch;
  }
  .trace-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block: 1.25rem;
  }
  .trace-controls[hidden] {
    display: none;
  }

  .chain {
    list-style: none;
    padding: 1.25rem 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    align-items: center;
    border-block: 1px solid var(--sl-color-gray-5);
  }
  .chain-item {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    text-align: center;
    color: var(--sl-color-gray-3);
    transition: color 200ms;
  }
  .chain-where {
    font-size: var(--sl-text-sm);
    line-height: 1.3;
  }
  .chain-layer {
    font-size: var(--sl-text-xs);
    font-style: italic;
  }
  .glyph {
    width: 2.75rem;
    height: 2.75rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
  }
  .wire {
    display: block;
    width: 100%;
    height: 0.75rem;
    border-top: 3px dotted currentColor;
  }
  .layer-rf .wire {
    border: 0;
    background: radial-gradient(circle at 50% 120%, transparent 0.42rem, currentColor 0.42rem 0.55rem, transparent 0.55rem) 0 0 / 1rem 0.75rem repeat-x;
  }
  .chain-item.is-done {
    color: var(--sl-color-gray-1);
  }
  .chain-item.is-current {
    color: var(--sl-color-accent-high);
  }
  .chain-item.is-current .chain-where {
    font-weight: 600;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 0.75rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .key::before {
    content: '';
    display: inline-block;
    width: 2rem;
    height: 0.6rem;
    margin-inline-end: 0.5rem;
    vertical-align: middle;
    border-top: 3px dotted currentColor;
  }
  .key-rf::before {
    border: 0;
    background: radial-gradient(circle at 50% 120%, transparent 0.32rem, currentColor 0.32rem 0.45rem, transparent 0.45rem) 0 0 / 0.75rem 0.6rem repeat-x;
  }

  .log-title {
    font-size: var(--sl-text-xl);
    margin-top: 2rem;
  }
  .log {
    padding-inline-start: 1.5rem;
  }
  .log li {
    margin-block: 0.75rem;
    max-width: 66ch;
  }
  .log li p {
    margin: 0.25rem 0 0;
  }
  .log li.is-current strong {
    color: var(--sl-color-accent-high);
  }
  .log-meta {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }
  .offgrid {
    border-inline-start: 3px solid var(--sl-color-accent);
    padding: 0.5rem 0 0.5rem 1rem;
    max-width: 66ch;
  }

  @media (max-width: 40rem) {
    .chain {
      grid-template-columns: 1fr;
      justify-items: start;
      padding-inline-start: 0.5rem;
      gap: 0.25rem;
    }
    .chain-item {
      flex-direction: row;
      gap: 0.75rem;
      text-align: start;
    }
    .chain-item.is-link {
      padding-inline-start: 1.25rem;
    }
    .wire,
    .layer-rf .wire {
      width: 0.75rem;
      height: 2.25rem;
      border-top: 0;
      border-inline-start: 3px dotted currentColor;
      background: none;
    }
    .layer-rf .wire {
      border-inline-start: 0;
      background: radial-gradient(circle at 120% 50%, transparent 0.42rem, currentColor 0.42rem 0.55rem, transparent 0.55rem) 0 0 / 0.75rem 1rem repeat-y;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .chain-item {
      transition: none;
    }
  }
</style>
