---
import { PACKETS, VIEWS, type View } from '../lib/packet-inspector.ts';
import LabCite from './LabCite.astro';

const VIEW_LABELS: Record<View, string> = { air: 'Over the air', transport: 'Phone ↔ radio', app: 'Application' };
const sizeText = (s: number | 'rest') => (s === 'rest' ? 'rest' : `${s} B`);
---

<section class="pi not-content" data-inspector aria-labelledby="pi-title">
  <h2 id="pi-title">Packet inspector</h2>
  <p class="pi-note">
    Small synthetic packets, not captures. Offsets appear only where the pinned implementation was read;
    bracketed values are placeholders, never real bytes. Prefixes a1, b2 and d4 are invented. Without
    JavaScript every packet and view is listed below.
  </p>

  <div class="pi-controls" data-ui hidden>
    <label class="pi-select">
      Packet
      <select data-pkt>
        {PACKETS.map((p) => <option value={p.id}>{p.label}</option>)}
      </select>
    </label>
    <fieldset>
      <legend>View</legend>
      {VIEWS.map((v, i) => (
        <label><input type="radio" name="pi-view" value={v} checked={i === 0} /> {VIEW_LABELS[v]}</label>
      ))}
    </fieldset>
  </div>

  {PACKETS.map((p) => (
    <article class="pi-packet" data-packet={p.id}>
      <h3>{p.label}</h3>
      <p>{p.scenario}</p>
      {VIEWS.map((v) => {
        const view = p.views[v];
        return (
          <section class="pi-view" data-view={v}>
            <h4>{VIEW_LABELS[v]}: {view.title}</h4>
            <p>{view.summary} {view.offsets ? 'Offsets and sizes follow the pinned layout.' : 'Schematic: no byte offsets are claimed for this view.'}</p>
            <div class="pi-strip" aria-hidden="true">
              {view.fields.map((f) => (
                <span class:list={['pi-seg', { 'is-opaque': f.opaque, 'is-schematic': f.schematic }]} style={`flex-grow: ${f.size === 'rest' ? 6 : Math.min(f.size, 8)}`}>
                  {f.name}
                </span>
              ))}
            </div>
            <div class="pi-scroll" tabindex="0" role="region" aria-label={`${p.label}, ${VIEW_LABELS[v]} layout`}>
              <table>
                <caption>Layout</caption>
                <thead>
                  <tr><th scope="col">Offset</th><th scope="col">Size</th><th scope="col">Field</th><th scope="col">Value</th><th scope="col">Meaning and evidence</th></tr>
                </thead>
                <tbody>
                  {view.fields.map((f) => (
                    <tr class:list={{ 'is-opaque': f.opaque }}>
                      <td>{f.offset ?? '—'}</td>
                      <td>{sizeText(f.size)}</td>
                      <th scope="row">{f.name}{f.opaque && <span class="pi-tag">encrypted</span>}</th>
                      <td><code>{f.value}</code>{f.endian && <span class="pi-tag">{f.endian === 'LE' ? 'little-endian' : 'big-endian'}</span>}</td>
                      <td>{f.meaning} <LabCite ids={f.claims} /></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            {view.note && <p class="pi-note">{view.note}</p>}
            <div class="pi-scroll" tabindex="0" role="region" aria-label={`${p.label}, ${VIEW_LABELS[v]}: who can infer what`}>
              <table>
                <caption>Who can infer what (an inference, not a capture)</caption>
                <thead>
                  <tr><th scope="col">Field</th><th scope="col">RF observer without keys</th><th scope="col">Relay</th><th scope="col">Recipient</th></tr>
                </thead>
                <tbody>
                  {view.fields.map((f) => (
                    <tr><th scope="row">{f.name}</th><td>{f.sees.observer}</td><td>{f.sees.relay}</td><td>{f.sees.recipient}</td></tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        );
      })}
    </article>
  ))}
</section>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-inspector]')) {
    const pkt = root.querySelector<HTMLSelectElement>('[data-pkt]')!;
    const views = [...root.querySelectorAll<HTMLInputElement>('input[name="pi-view"]')];
    const show = () => {
      const v = views.find((r) => r.checked)!.value;
      for (const a of root.querySelectorAll<HTMLElement>('[data-packet]')) {
        a.hidden = a.dataset.packet !== pkt.value;
        for (const s of a.querySelectorAll<HTMLElement>('[data-view]')) s.hidden = s.dataset.view !== v;
      }
    };
    pkt.addEventListener('change', show);
    for (const r of views) r.addEventListener('change', show);
    show();
    root.querySelector<HTMLElement>('[data-ui]')!.hidden = false;
  }
</script>

<style>
  .pi {
    margin-block: 1.5rem;
  }
  .pi [hidden] {
    display: none !important;
  }
  .pi-note {
    color: var(--sl-color-gray-3);
    max-width: 66ch;
  }
  .pi-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: end;
  }
  .pi-controls fieldset {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.25rem;
    padding: 0.5rem 1rem;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
  }
  .pi-controls label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
  }
  /* Label above the select when the long option text can't fit beside it (320 px). */
  .pi-select {
    flex-wrap: wrap;
    min-width: 0;
    max-width: 100%;
  }
  .pi-select select {
    min-width: 0;
    max-width: 100%;
    min-height: 2.75rem;
    font: inherit;
    color: var(--sl-color-white);
    background: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 0.25rem;
    max-width: 100%;
  }
  input[type='radio'] {
    width: 1.25rem;
    height: 1.25rem;
    accent-color: var(--sl-color-accent);
  }
  .pi-packet {
    margin-top: 1.5rem;
  }
  .pi-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 2px;
    margin-block: 0.75rem;
    font-size: var(--sl-text-xs);
  }
  .pi-seg {
    flex-basis: 0;
    min-width: 2.5rem;
    padding: 0.35rem 0.25rem;
    border: 1px solid var(--sl-color-gray-3);
    background: var(--sl-color-gray-6);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .pi-seg.is-schematic {
    border-style: dashed;
  }
  .pi-seg.is-opaque {
    background: repeating-linear-gradient(45deg, var(--sl-color-gray-5) 0 4px, var(--sl-color-gray-6) 4px 8px);
  }
  .pi-scroll {
    overflow-x: auto;
    margin-block: 0.75rem;
  }
  .pi-scroll:focus-visible {
    outline: 2px solid var(--sl-color-accent);
  }
  table {
    border-collapse: collapse;
    font-size: var(--sl-text-sm);
    min-width: 36rem;
  }
  caption {
    text-align: start;
    font-weight: 600;
    padding-block: 0.25rem;
  }
  th,
  td {
    text-align: start;
    vertical-align: top;
    padding: 0.35rem 0.5rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
  }
  tbody th {
    font-weight: 600;
  }
  tr.is-opaque th {
    font-style: italic;
  }
  .pi-tag {
    display: inline-block;
    margin-inline-start: 0.4rem;
    padding: 0 0.3rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 0.2rem;
    font-size: var(--sl-text-xs);
    font-weight: 400;
    font-style: normal;
  }
</style>
